:relative;background:#fff;border:1px solid var(--line);border-top:none;padding:26px 28px 26px 96px}\n.step:first-child{border-top:1px solid var(--line)}\n.step::before{counter-increment:step;content:counter(step,decimal-leading-zero);position:absolute;left:24px;top:22px;font-size:34px;font-weight:800;color:var(--teal)}\n.step h3{font-size:17px;color:var(--slate-deep);margin-bottom:6px;font-weight:700}\n.step p{font-size:14.5px;color:var(--slate-soft);max-width:56em}\n.step p code{background:var(--paper-2);padding:1px 7px;font-size:13px;color:var(--teal-ink);font-family:ui-monospace,Menlo,Consolas,monospace}\n\n/* ---------- 客户端 ---------- */\n.client-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}\n.client-card{position:relative;background:#fff;border:1px solid var(--line);padding:24px 22px 80px;overflow:hidden}\n.client-card .bignum{position:absolute;right:8px;bottom:-24px;font-size:100px;font-weight:800;color:var(--num);line-height:1;pointer-events:none}\n.client-card h3{font-size:17px;color:var(--slate-deep);margin-bottom:6px}\n.client-card p{font-size:13.5px;color:var(--slate-soft);margin-bottom:12px}\n.client-card .clink{font-size:13px;font-weight:600;color:var(--teal-deep)}\n\n/* ---------- FAQ 编号列表 ---------- */\n.faq-list{counter-reset:faq;display:grid;gap:0}\n.faq-item{counter-increment:faq;background:#fff;border:1px solid var(--line);border-top:none;padding:24px 28px 24px 92px;position:relative}\n.faq-item:first-child{border-top:1px solid var(--line)}\n.faq-item::before{content:\"Q\" counter(faq);position:absolute;left:24px;top:24px;font-size:15px;font-weight:800;color:var(--teal);letter-spacing:.04em}\n.faq-item h3{font-size:16.5px;color:var(--slate-deep);font-weight:700;margin-bottom:8px}\n.faq-item .ans{font-size:14.5px;color:var(--slate-soft)}\n.faq-item .ans b{color:var(--slate-deep)}\n\n/* ---------- 页脚 ---------- */\nfooter{background:var(--slate-deep);color:#8b979e;padding:44px 0;font-size:13px}\nfooter .wrap{display:flex;flex-wrap:wrap;gap:14px 30px;justify-content:space-between;align-items:center}\nfooter b{color:#e8edef}\nfooter a{color:#7fd4d4}\n\n@media (max-width:860px){\n  .hero-grid{grid-template-columns:1fr;gap:40px}\n  .plan-row summary{grid-template-columns:1fr;gap:8px}\n  .plan-row summary .pprice small{text-align:left}\n  .plan-row .pbody{grid-template-columns:1fr;padding-bottom:110px}\n  .step{padding-left:78px}\n  .faq-item{padding-left:78px}\n}\n</style><nav class=\"crumbs\" aria-label=\"面包屑\">\n  <div class=\"wrap\">\n    <b>HaoBa</b>\n    <span class=\"sep\">/</span>\n    <span>官方指南</span>\n    <span class=\"sep\">/</span>\n    <span>选套餐之前，先回答几个问题</span>\n  </div>\n</nav>\n\n<nav class=\"toc\" aria-label=\"页面目录\">\n  <div class=\"wrap\">\n    <a href=\"#ask\">三个问题</a>\n    <a href=\"#plans\">套餐逐行看</a>\n    <a href=\"#guide\">上手说明</a>\n    <a href=\"#clients\">客户端</a>\n    <a href=\"#faq\">常见问题</a>\n  </div>\n</nav>\n\n<main>\n\n\n<header class=\"hero\">\n  <div class=\"wrap hero-grid\">\n    <div>\n      <span class=\"kicker\">HAOBA 选购指南</span>\n      <h1>别急着下单，<br>先让 <em>HaoBa</em> 问你三个问题。</h1>\n      <p class=\"lead\">大多数人选错套餐，不是因为看不懂价格，而是没想清楚自己的用法。<strong>设备有几台？每月用多少流量？出问题需不需要人马上响应？</strong>答完这三问，该买哪一档基本就自己浮出来了。</p>\n      <div class=\"ask\">\n        <p>问一：你同时在线的设备，超过 3 台了吗？</p>\n        <p>问二：你每月的流量，是 100GB 够用，还是 300GB 才安心？</p>\n        <p>问三：你是一个人用，还是要给一整个团队铺路？</p>\n        <p><a href=\"#ask\">带着答案往下看 →</a></p>\n      </div>\n    </div>\n    <aside class=\"panel\" aria-label=\"速览面板\">\n      <h2>30 秒速览</h2>\n      <dl>\n        <div>\n          <dt>在售档位</dt>\n          <dd><b>3 档</b> — 基础 / 旗舰 / 团队</dd>\n        </div>\n        <div>\n          <dt>起步价</dt>\n          <dd><b>¥15</b> / 月</dd>\n        </div>\n        <div>\n          <dt>年付优惠</dt>\n          <dd>三档均支持，约相当于 <b>省两个月</b></dd>\n        </div>\n        <div>\n          <dt>设备上限</dt>\n          <dd>3 台 / 5 台 / 20 台，按档位递增</dd>\n        </div>\n      </dl>\n      <div class=\"hr\"></div>\n      <a class=\"go\" href=\"#plans\">直接对照套餐</a>\n      <p class=\"note\">不确定？先读下面的\"三个问题\"，比直接看价格表省时间。</p>\n    </aside>\n  </div>\n</header>\n\n\n<section class=\"block\" id=\"ask\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"tag\">STEP 0 · 自我提问</span>\n      <h2>哪一个问题，最戳中你？</h2>\n      <p>不用三个都答。找到那个让你\"对，就是这样\"的问题，它指向的档位通常就是答案。</p>\n    </div>\n    <div class=\"num-grid\">\n      <article class=\"num-card\">\n        <span class=\"q\">\"我的设备好像越来越多……\"</span>\n        <h3>先数设备，再谈流量</h3>\n        <p>手机、电脑、平板，再加上客厅那台电视盒子——同时在线的设备数是最容易被低估的一项。基础版允许 3 台同时在线，旗舰版放宽到 5 台，团队版直接给到 20 台。数清楚，再往下走。</p>\n        <span class=\"bignum\">01</span>\n      </article>\n      <article class=\"num-card\">\n        <span class=\"q\">\"月底总是提心吊胆……\"</span>\n        <h3>流量焦虑来自估不准</h3>\n        <p>日常浏览和偶尔看视频，100GB 往往够；但如果你是高清流媒体的重度用户，300GB 才谈得上从容。团队共享场景下，1000GB 是起点而不是上限。回想一下上个月的用量，它比任何推荐都诚实。</p>\n        <span class=\"bignum\">02</span>\n      </article>\n      <article class=\"num-card\">\n        <span class=\"q\">\"出问题的时候，我等不起……\"</span>\n        <h3>支持等级也是成本</h3>\n        <p>普通工单排队处理，对多数个人用户足够；但如果你靠它开会、打游戏、跑业务，旗舰版的 7×24 优先工单和团队版的专属客户经理，买的其实是\"确定性\"。问问自己：断一小时，代价是什么？</p>\n        <span class=\"bignum\">03</span>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block alt\" id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"tag\">PLANS · 逐行展开</span>\n      <h2>三档套餐，点开哪档看哪档</h2>\n      <p>价格、流量、设备数逐行对照。每一档都可以展开看完整权益和适合人群，不用来回翻页。</p>\n    </div>\n\n    <details class=\"plan-row\">\n      <summary>\n        <span class=\"pname\">基础版<small>一个人、两三台设备、用量克制</small></span>\n        <span class=\"pprice\">¥15/月<small>按年付 ¥150/年</small></span>\n        <span class=\"toggle\">展开权益</span>\n      </summary>\n      <div class=\"pbody\">\n        <div>\n          <h4>包含权益</h4>\n          <ul>\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n        <div class=\"fit\">\n          <h4>适合谁</h4>\n          <p>如果你是第一次尝试，或者 usage 很规律——通勤路上刷刷内容、晚上偶尔看剧——基础版是试错成本最低的选择。</p>\n          <p>年付 ¥150，相当于每月 ¥12.5，比月付省下两杯咖啡的钱。</p>\n        </div>\n      </div>\n      <span class=\"bignum\">01</span>\n    </details>\n\n    <details class=\"plan-row featured\">\n      <summary>\n        <span class=\"pname\">旗舰版<small>重度个人用户的首选平衡点</small></span>\n        <span class=\"pprice\">¥35/月<small>按年付 ¥350/年</small></span>\n        <span class=\"toggle\">展开权益</span>\n      </summary>\n      <div class=\"pbody\">\n        <div>\n          <h4>包含权益</h4>\n          <ul>\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </div>\n        <div class=\"fit\">\n          <h4>适合谁</h4>\n          <p>设备超过 3 台、流媒体要看全库、偶尔打游戏在意延迟——这三条里中了两条，旗舰版基本就是为你准备的。</p>\n          <p>优先工单意味着问题不排队。对靠网络吃饭的人来说，这一项往往值回差价。</p>\n        </div>\n      </div>\n      <span class=\"bignum\">02</span>\n    </details>\n\n    <details class=\"plan-row\">\n      <summary>\n        <span class=\"pname\">团队版<small>多人共享、企业级需求</small></span>\n        <span class=\"pprice\">¥85/月<small>按年付 ¥850/年</small></span>\n        <span class=\"toggle\">展开权益</span>\n      </summary>\n      <div class=\"pbody\">\n        <div>\n          <h4>包含权益</h4>\n          <ul>\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n        <div class=\"fit\">\n          <h4>适合谁</h4>\n          <p>小团队共用一个账户、需要定制路由规则、或者希望出问题时有专人对接而不是提交工单——这些需求一旦出现，个人版就装不下了。</p>\n          <p>摊到 20 台设备上，每台每月约 ¥4.25，比给每个人单独开户划算得多。</p>\n        </div>\n      </div>\n      <span class=\"bignum\">03</span>\n    </details>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"guide\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"tag\">GUIDE · 上手说明</span>\n      <h2>从付款到能用，一共四步</h2>\n      <p>整个过程不需要技术背景。按顺序做，每步都有明确的\"做完了\"的标志。</p>\n    </div>\n    <div class=\"steps\">\n      <article class=\"step\">\n        <h3>选定档位并完成支付</h3>\n        <p>在上面的套餐区确认档位，选择月付或年付。支付成功后，账户信息会发送到你预留的邮箱——看到这封邮件，第一步就算完成。</p>\n      </article>\n      <article class=\"step\">\n        <h3>登录用户中心，复制订阅信息</h3>\n        <p>用邮箱和初始密码登录 HaoBa 用户中心，在\"我的订阅\"页面找到订阅链接或配置信息，点击复制。建议同时把密码改掉，顺手的事。</p>\n      </article>\n      <article class=\"step\">\n        <h3>在你的设备上导入配置</h3>\n        <p>打开你设备上对应的客户端（见下方客户端区块），选择\"从剪贴板导入\"或\"添加订阅\"，粘贴刚才复制的内容。客户端列表里出现节点，说明导入成功。</p>\n      </article>\n      <article class=\"step\">\n        <h3>选一个节点，验证连通性</h3>\n        <p>在节点列表中任选一个，开启连接，然后打开一个平时打不开的页面验证。能正常加载，就说明全部配置完成。之后客户端会自动同步订阅，无需重复导入。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block alt\" id=\"clients\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"tag\">CLIENTS · 各平台</span>\n      <h2>你用什么设备，就装什么客户端</h2>\n      <p>HaoBa 的订阅信息是通用的，客户端按平台自选。以下为主流平台的常用选择，下载地址以各客户端官方渠道为准。</p>\n    </div>\n    <div class=\"client-grid\">\n      <article class=\"client-card\">\n        <h3>Windows</h3>\n        <p>桌面端常用 Clash 系或 v2ray 系客户端，导入订阅链接即可使用。具体下载地址请前往客户端官方发布页获取。</p>\n        <span class=\"clink\">官方渠道获取 →</span>\n        <span class=\"bignum\">W</span>\n      </article>\n      <article class=\"client-card\">\n        <h3>macOS</h3>\n        <p>Mac 用户同样以 Clash 系客户端为主流，支持订阅自动更新。请通过客户端官方渠道下载对应架构的版本。</p>\n        <span class=\"clink\">官方渠道获取 →</span>\n        <span class=\"bignum\">M</span>\n      </article>\n      <article class=\"client-card\">\n        <h3>iOS</h3>\n        <p>iPhone 与 iPad 需通过 App Store 安装支持订阅的客户端应用，部分应用可能需要非国区账号。安装后粘贴订阅链接即可。</p>\n        <span class=\"clink\">App Store 获取 →</span>\n        <span class=\"bignum\">i</span>\n      </article>\n      <article class=\"client-card\">\n        <h3>Android</h3>\n        <p>安卓平台选择最多，Clash 系与 v2ray 系均有成熟客户端。建议从官方发布页或正规应用市场下载，避免来历不明的安装包。</p>\n        <span class=\"clink\">官方渠道获取 →</span>\n        <span class=\"bignum\">A</span>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"block\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sec-head\">\n      <span class=\"tag\">FAQ · 常见问题</span>\n      <h2>你可能还想问</h2>\n      <p>按提问频率排序。没找到答案的，可以通过用户中心提交工单。</p>\n    </div>\n    <div class=\"faq-list\">\n      <article class=\"faq-item\">\n        <h3>流量用完了会怎样？</h3>\n        <p class=\"ans\">当月流量用完后，连接会暂停，次月自动重置额度。如果你经常提前用完，说明当前档位偏低，建议对照上面的\"三个问题\"重新评估，升级到更高档位比硬撑更划算。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>设备数量是怎么计算的？</h3>\n        <p class=\"ans\">按<b>同时在线</b>的设备数计算，不是按绑定数量。比如基础版支持 3 台同时在线，你可以在更多设备上安装客户端，只是同一时间最多 3 台保持连接。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>月付可以随时改成年付吗？</h3>\n        <p class=\"ans\">可以。在用户中心选择年付方案即可，年付价格为基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年，相比月付各省下约两个月的费用。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>中途想换档位怎么办？</h3>\n        <p class=\"ans\">支持在用户中心变更套餐。向上升级通常即时生效；降档建议在当前计费周期结束前操作，避免额度变化带来的困惑。具体以用户中心显示的规则为准。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>客户端导入订阅后没有节点显示？</h3>\n        <p class=\"ans\">先确认订阅链接复制完整、没有多余空格；然后在客户端里手动触发一次\"更新订阅\"。仍然没有的话，回到用户中心检查订阅状态是否正常，必要时通过工单联系支持。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>团队版的\"定制路由\"是什么意思？</h3>\n        <p class=\"ans\">指按团队需求配置流量走向规则，例如指定某些服务走特定节点。这项服务由专属客户经理对接，开通团队版后可以直接提出需求，不需要自己研究配置语法。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span><b>HaoBa</b> — 先想清楚，再下单。</span>\n    <span><a href=\"#ask\">三个问题</a> · <a href=\"#plans\">套餐</a> · <a href=\"#guide\">上手</a> · <a href=\"#faq\">FAQ</a></span>\n  </div>\n</footer>",
